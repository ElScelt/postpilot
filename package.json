{
  "name": "postpilot",
  "version": "1.2.1",
  "description": "Self-hosted autopilot for LinkedIn posts: researches recent sources, drafts a grounded post overnight, and publishes it in the morning unless you reject it from your phone.",
  "private": true,
  "license": "MIT",
  "author": "Edgar Raudsepp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElScelt/postpilot.git"
  },
  "homepage": "https://github.com/ElScelt/postpilot#readme",
  "bugs": {
    "url": "https://github.com/ElScelt/postpilot/issues"
  },
  "keywords": [
    "linkedin",
    "nextjs",
    "vercel",
    "qstash",
    "groq",
    "tavily",
    "ntfy",
    "automation"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./test/setup.ts --test \"test/*.test.ts\"",
    "test:redis": "tsx --import ./test/setup.ts --test --test-concurrency=1 \"test/redis/*.test.ts\"",
    "test:coverage": "tsx --import ./test/setup.ts --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=96 --test-coverage-branches=89 --test-coverage-functions=94 \"test/*.test.ts\"",
    "draft": "node --env-file-if-exists=.env.local --import tsx scripts/draft.ts",
    "check:data": "node --env-file-if-exists=.env.local --import tsx scripts/check-data.ts"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.4"
  },
  "dependencies": {
    "@upstash/qstash": "2.11.3",
    "@upstash/redis": "1.39.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  }
}
