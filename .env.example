# Secrets and infrastructure only. What gets posted and when lives in postpilot.config.ts.
# Copy this file to .env.local for local runs; set the same variables in Vercel.

# LinkedIn app with both "Share on LinkedIn" and "Sign In with LinkedIn using OpenID
# Connect" enabled. Create a fresh client secret in the developer portal.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-project.vercel.app/api/auth/linkedin/callback
LINKEDIN_STATE_SECRET=

# Optional. The LinkedIn member id (the "sub" the callback prints) this deployment may
# post as. Unset, the first member to connect binds the deployment.
LINKEDIN_MEMBER_ID=

# The canonical production origin, with no path and no trailing slash. QStash signatures
# are checked against it, so it must be the host that actually serves the app.
APP_URL=https://your-project.vercel.app

# Autonomous schedule authentication and grounded drafting.
AUTOMATION_SECRET=
GROQ_API_KEY=
TAVILY_API_KEY=

# Free ntfy.sh topic for the nightly draft notification, its Reject button, and every
# operator alert (failed runs, skipped nights, expiring authorization). The topic name
# is the only secret protecting it, so generate a long random one. Without it drafts
# publish unreviewed and nothing alerts you.
NTFY_TOPIC=

# Optional. Self-hosted ntfy server and access token for a reserved topic.
NTFY_URL=
NTFY_TOKEN=

# Optional. healthchecks.io ping URL for a check whose cron and time zone match the
# schedule in postpilot.config.ts ("0 21 * * 0,2,4" in UTC by default); pages you when a
# run never fires.
HEALTHCHECK_URL=

# Optional model override. Only the gpt-oss models support the strict structured output
# the drafting relies on.
GROQ_MODEL=openai/gpt-oss-120b

# Added by the Upstash QStash integration in Vercel.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Added by the Upstash Redis integration in Vercel. A database created directly in the
# Upstash console gives UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN instead;
# either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
